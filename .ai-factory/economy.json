{
  "schema_version": "1.0",
  "policy_name": "Economy",
  "enforcement": "agentflow_settings_and_agent_prompts",
  "max_active_executor_tasks_global": 1,
  "max_executor_tasks_per_request": 2,
  "max_repair_rounds": 1,
  "max_model_escalations_per_request": 1,
  "max_request_minutes": 15,
  "native_auto_retry": false,
  "full_transcripts_default": false,
  "parallel_reasoning_default": false,
  "browser_only_when_required": true,
  "context_order": [
    "PROJECT.md",
    "task.json",
    "relevant_files",
    "validated_handoff_or_diff"
  ],
  "default_routes": {
    "manager": "claude:haiku",
    "implementation": "codex:gpt-5.6-luna",
    "browser_qa": "antigravity:gemini-3.8-flash-low"
  },
  "on_limit": "preserve_checkpoint_and_report_blocked"
}
